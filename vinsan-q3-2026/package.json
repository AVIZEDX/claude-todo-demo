{
  "name": "vinsan-q3-2026-glance",
  "version": "1.0.0",
  "private": true,
  "description": "Vinsan Quarterly Q3 2026 — The Quarter at a Glance (Remotion motion graphic)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "qa": "tsx scripts/qa-data.ts",
    "soundtrack": "tsx scripts/generate-soundtrack.ts",
    "render": "npm run qa && npm run soundtrack && remotion render src/index.ts VinsanQ3Glance out/vinsan-q3-2026-glance.mp4 --codec=h264 --crf=16",
    "stills": "tsx scripts/render-stills.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@remotion/bundler": "^4.0.533",
    "@remotion/cli": "^4.0.533",
    "@remotion/renderer": "^4.0.533",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.533"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
